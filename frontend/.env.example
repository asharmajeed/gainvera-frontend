# Agency / and fixture /ecommerce need no configuration.
# For /ecommerce/account, copy to ignored .env.local and set public values only.
# NEXT_PUBLIC_ values are included in the browser bundle at build time.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_public_key
NEXT_PUBLIC_GAINVERA_API_URL=http://127.0.0.1:8000
# Restart dev / rebuild production after changing these values.
# Use frontend localhost:3100 or 127.0.0.1:3100 (3101 is outside default CORS).
# Never put passwords, access/refresh tokens, DB credentials, service/secret keys here.
